---
interface Props {
  variant?: 'mission' | 'impact';
}

const { variant = 'mission' } = Astro.props;

const isMission = variant === 'mission';
const primaryColorClass = isMission ? 'text-teal-deep dark:text-primary' : 'text-secondary-teal dark:text-primary-gold';
const navLinkHoverClass = isMission ? 'hover:text-primary' : 'hover:text-primary-gold';
const activeLinkClass = !isMission ? 'text-primary-gold underline underline-offset-8' : '';
const buttonClass = isMission ? 'bg-primary shadow-primary/20' : 'bg-accent-red shadow-accent-red/20';
---

<header class="sticky top-0 z-50 w-full border-b border-primary/10 bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-md">
  <div class="drawer drawer-end">
    <input id="mobile-menu" type="checkbox" class="drawer-toggle" />
    <div class="drawer-content flex flex-col">
      <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-4 h-20">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-3">
            <div class={`flex h-10 w-10 items-center justify-center rounded-full ${isMission ? 'bg-primary' : 'bg-primary-gold'} text-white`}>
              <span class="material-symbols-outlined">{isMission ? 'flutter_dash' : 'diversity_3'}</span>
            </div>
            <h2 class={`text-xl font-bold tracking-tight ${primaryColorClass}`}>AFT Kids & Elders</h2>
          </a>
        </div>

        <nav class="hidden md:flex items-center gap-8">
          <div class="dropdown dropdown-hover">
            <div tabindex="0" role="button" class={`text-sm font-semibold flex items-center gap-1 text-teal-deep dark:text-slate-300 ${navLinkHoverClass} transition-colors`}>
              About Us <span class="material-symbols-outlined text-sm">expand_more</span>
            </div>
            <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-background-light dark:bg-background-dark rounded-box w-52 border border-primary/10">
              <li><a href="/" class={navLinkHoverClass}>Our Mission</a></li>
              <li><a href="/#team" class={navLinkHoverClass}>Our Team</a></li>
              <li><a href="/#programs" class={navLinkHoverClass}>Core Programs</a></li>
            </ul>
          </div>

          <a class={`text-sm font-semibold text-teal-deep dark:text-slate-300 ${navLinkHoverClass} transition-colors`} href="/discover">Discover Sri Lanka</a>

          <div class="dropdown dropdown-hover">
            <div tabindex="0" role="button" class={`text-sm font-semibold flex items-center gap-1 text-teal-deep dark:text-slate-300 ${navLinkHoverClass} transition-colors`}>
              Impact <span class="material-symbols-outlined text-sm">expand_more</span>
            </div>
            <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-background-light dark:bg-background-dark rounded-box w-52 border border-primary/10">
              <li><a href="/impact" class={navLinkHoverClass}>Our Impact</a></li>
              <li><a href="/impact#stories" class={navLinkHoverClass}>Success Stories</a></li>
              <li><a href="/impact#news" class={navLinkHoverClass}>Latest News</a></li>
              <li><a href="/impact#reports" class={navLinkHoverClass}>Reports</a></li>
            </ul>
          </div>
        </nav>

        <div class="flex items-center gap-4">
          <button class={`hidden sm:block rounded-full px-6 py-2 text-sm font-bold text-white shadow-lg transition-all hover:opacity-90 active:scale-95 ${buttonClass}`}>
            Donate Now
          </button>
          <label for="mobile-menu" class="btn btn-ghost btn-circle md:hidden">
            <span class="material-symbols-outlined">menu</span>
          </label>
        </div>
      </div>
    </div>
    <div class="drawer-side">
      <label for="mobile-menu" aria-label="close sidebar" class="drawer-overlay"></label>
      <ul class="menu p-4 w-80 min-h-full bg-background-light dark:bg-background-dark text-base-content">
        <div class="flex items-center gap-3 mb-8 px-4 py-2">
          <div class={`flex h-10 w-10 items-center justify-center rounded-full ${isMission ? 'bg-primary' : 'bg-primary-gold'} text-white`}>
            <span class="material-symbols-outlined">{isMission ? 'flutter_dash' : 'diversity_3'}</span>
          </div>
          <h2 class={`text-xl font-bold tracking-tight ${primaryColorClass}`}>AFT Kids & Elders</h2>
        </div>

        <div class="collapse collapse-arrow">
          <input type="radio" name="mobile-nav" checked="checked" />
          <div class="collapse-title text-lg font-semibold">About Us</div>
          <div class="collapse-content">
            <ul class="menu menu-sm">
              <li><a href="/">Our Mission</a></li>
              <li><a href="/#team">Our Team</a></li>
              <li><a href="/#programs">Core Programs</a></li>
            </ul>
          </div>
        </div>

        <li><a class="text-lg font-semibold" href="/discover">Discover Sri Lanka</a></li>

        <div class="collapse collapse-arrow">
          <input type="radio" name="mobile-nav" />
          <div class="collapse-title text-lg font-semibold">Impact</div>
          <div class="collapse-content">
            <ul class="menu menu-sm">
              <li><a href="/impact">Our Impact</a></li>
              <li><a href="/impact#stories">Success Stories</a></li>
              <li><a href="/impact#news">Latest News</a></li>
              <li><a href="/impact#reports">Reports</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-8 px-4">
          <button class={`w-full rounded-full px-6 py-4 text-lg font-bold text-white shadow-lg transition-all hover:opacity-90 active:scale-95 ${buttonClass}`}>
            Donate Now
          </button>
        </div>
      </ul>
    </div>
  </div>
</header>
