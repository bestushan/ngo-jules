---
---
<section class="py-20 bg-teal-deep text-white">
  <div class="mx-auto max-w-5xl px-6">
    <div class="rounded-3xl border border-white/10 bg-white/5 p-12 backdrop-blur-lg">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold mb-6">Transparency & Unwavering Trust</h2>
          <p class="text-sea-foam/80 mb-8 leading-relaxed">
            We believe in radical transparency. Every cent donated by the public is funneled directly into our core programs. Our administrative costs are covered by our founders and corporate partners.
          </p>
          <div class="flex items-center gap-4 mb-8">
            <div class="text-5xl font-black text-primary">100%</div>
            <div class="text-sm uppercase tracking-widest font-bold">Of Public Donations<br/>Go to Programs</div>
          </div>
          <a class="inline-flex items-center gap-2 text-primary font-bold hover:underline" href="#">
            View Financial Reports <span class="material-symbols-outlined">arrow_right_alt</span>
          </a>
        </div>
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-4 rounded-xl bg-white/10 p-4">
            <span class="material-symbols-outlined text-primary">verified</span>
            <div>
              <h5 class="font-bold">Registered Charity</h5>
              <p class="text-xs text-white/60">Official NGO License Sri Lanka</p>
            </div>
          </div>
          <div class="flex items-center gap-4 rounded-xl bg-white/10 p-4">
            <span class="material-symbols-outlined text-primary">analytics</span>
            <div>
              <h5 class="font-bold">Quarterly Impact Audits</h5>
              <p class="text-xs text-white/60">Independent third-party verification</p>
            </div>
          </div>
          <div class="flex items-center gap-4 rounded-xl bg-white/10 p-4">
            <span class="material-symbols-outlined text-primary">location_on</span>
            <div>
              <h5 class="font-bold">Direct Local Delivery</h5>
              <p class="text-xs text-white/60">Administered on-ground in Kandy</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
