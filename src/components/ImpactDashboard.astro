---
const stats = [
  { icon: 'school', label: 'Students Supported', value: '347+', trend: '+12% YoY', trend_icon: 'trending_up' },
  { icon: 'family_restroom', label: 'Families Reached', value: '1,200+', trend: '+8% Reach', trend_icon: 'trending_up' },
  { icon: 'map', label: 'Communities', value: '22', trend: 'New Region', trend_icon: 'add_location' },
  { icon: 'verified_user', label: 'Transparency', value: '100%', trend: 'Direct Program Funding' }
];
---
<section class="py-24 bg-background-light dark:bg-background-dark">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-secondary-teal dark:text-primary-gold text-3xl font-bold mb-4">Measurable Transformation</h2>
      <div class="w-20 h-1 bg-primary-gold mx-auto opacity-50"></div>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
      {stats.map((stat) => (
        <div class="group p-8 rounded-2xl bg-white dark:bg-slate-800/50 border border-primary-gold/10 hover:border-primary-gold/40 transition-all shadow-sm">
          <span class="material-symbols-outlined text-primary-gold text-4xl mb-4 group-hover:scale-110 transition-transform">{stat.icon}</span>
          <p class="text-slate-500 dark:text-slate-400 text-sm font-semibold uppercase tracking-widest mb-2">{stat.label}</p>
          <p class="text-secondary-teal dark:text-white text-4xl font-black tracking-tight">{stat.value}</p>
          <p class="text-green-600 text-sm mt-3 flex items-center gap-1 font-bold">
            {stat.trend_icon && <span class="material-symbols-outlined text-xs">{stat.trend_icon}</span>} {stat.trend}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
