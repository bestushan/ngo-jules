      <span class="material-symbols-outlined text-5xl text-primary mb-6">waves</span>
      <h2 class="font-serif text-4xl italic text-teal-deep dark:text-primary mb-8">
        "From the foam of struggle, we rise with the grace of a butterfly."
      </h2>
    </div>
    <div class="grid md:grid-cols-2 gap-12 text-left items-center">
      <div class="space-y-6">
        <p class="text-lg leading-relaxed text-teal-deep/80 dark:text-slate-300">
