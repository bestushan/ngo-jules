---
---
<section id="reports" class="py-24 bg-white dark:bg-slate-800/20">
  <div class="max-w-7xl mx-auto px-6">
    <div class="bg-secondary-teal p-12 md:p-20 rounded-[2rem] relative overflow-hidden text-white">
      <div class="absolute top-0 right-0 w-64 h-64 bg-primary-gold/10 rounded-full -mr-20 -mt-20 blur-3xl"></div>
      <div class="relative z-10 grid md:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-white text-4xl font-black mb-6">Unwavering Transparency</h2>
          <p class="text-slate-300 text-lg mb-10 leading-relaxed">
            We believe in full accountability to our donors and the communities we serve. Explore our detailed financial breakdowns and impact metrics.
          </p>
          <div class="flex flex-wrap gap-4">
            <button class="bg-primary-gold text-white px-8 py-4 rounded-xl font-bold hover:bg-primary-gold/90 flex items-center gap-2 transition-all">
              <span class="material-symbols-outlined">download</span> 2023 Annual Report (PDF)
            </button>
            <button class="bg-white/10 text-white border border-white/20 px-8 py-4 rounded-xl font-bold hover:bg-white/20 transition-all">
              Financial Audit 2023
            </button>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-6">
          <div class="bg-white/5 border border-white/10 p-6 rounded-2xl">
            <h4 class="text-primary-gold font-bold mb-2">Impact Audit</h4>
            <p class="text-slate-400 text-sm">Third-party verified outcomes for all education programs.</p>
          </div>
          <div class="bg-white/5 border border-white/10 p-6 rounded-2xl">
            <h4 class="text-primary-gold font-bold mb-2">Cost Efficiency</h4>
            <p class="text-slate-400 text-sm">Low overhead ensuring maximum funds reach beneficiaries.</p>
          </div>
          <div class="bg-white/5 border border-white/10 p-6 rounded-2xl">
            <h4 class="text-primary-gold font-bold mb-2">Sustainable</h4>
            <p class="text-slate-400 text-sm">Long-term development goals centered on empowerment.</p>
          </div>
          <div class="bg-white/5 border border-white/10 p-6 rounded-2xl">
            <h4 class="text-primary-gold font-bold mb-2">Global Standards</h4>
            <p class="text-slate-400 text-sm">Adhering to international NGO reporting frameworks.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
