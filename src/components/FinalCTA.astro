---
---
<section class="relative py-24 overflow-hidden bg-primary">
  <div class="absolute inset-0 opacity-10">
    <svg height="100%" width="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern height="40" id="grid" patternunits="userSpaceOnUse" width="40">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="1"></path>
        </pattern>
      </defs>
      <rect fill="url(#grid)" height="100%" width="100%"></rect>
    </svg>
  </div>
  <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
    <h2 class="text-4xl font-black text-white md:text-5xl leading-tight">Ready to weave your own thread of change?</h2>
    <p class="mt-6 text-xl text-white/90">Join the mission today. Your contribution directly transforms lives in Kandy.</p>
    <div class="mt-12 flex flex-col md:flex-row justify-center gap-6">
      <button class="rounded-full bg-white px-10 py-5 text-lg font-bold text-primary shadow-2xl hover:bg-sea-foam transition-all">Donate Now</button>
      <button class="rounded-full border-2 border-white px-10 py-5 text-lg font-bold text-white hover:bg-white hover:text-primary transition-all">Become a Volunteer</button>
    </div>
  </div>
</section>
