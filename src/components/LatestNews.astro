<section class="py-24 bg-background-light dark:bg-background-dark">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-secondary-teal dark:text-primary-gold text-3xl font-bold mb-12 text-center">Field Updates & News</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      {articles.map((article) => (
        <article class="flex flex-col gap-4">
          <div class="aspect-video bg-slate-200 rounded-xl overflow-hidden mb-2">
            <img class="w-full h-full object-cover" src={article.img} alt={article.title} />
          </div>
          <div class="flex items-center gap-3 text-xs text-primary-gold font-bold uppercase tracking-widest">
            <span>{article.date}</span>
            <span class="w-1 h-1 bg-primary-gold rounded-full"></span>
            <span>{article.location}</span>
          </div>
          <h3 class="text-xl font-bold text-secondary-teal dark:text-white leading-tight hover:text-primary-gold transition-colors cursor-pointer">
            {article.title}
          </h3>
          <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
            {article.description}
          </p>
          <a class="text-accent-red text-sm font-bold flex items-center gap-1 group mt-2" href="#">
            Read Story <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">chevron_right</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
