---
const programs = [
  { icon: 'school', title: 'Education & Scholarships', description: 'Paving academic pathways for brilliant minds in underprivileged communities.' },
  { icon: 'psychology', title: 'Mentoring & Youth', description: 'Guiding the next generation through wisdom and shared experience.' },
  { icon: 'sports_soccer', title: 'Sports & Development', description: 'Building character, discipline, and health through athletic excellence.' },
  { icon: 'health_and_safety', title: 'Health & Well-being', description: 'Ensuring access to quality medical care and nutritional support.' },
  { icon: 'elderly', title: 'Elderly Care', description: 'Dignified living and community for the elders of Kandy.' }
];
---
<section id="programs" class="py-24 bg-white dark:bg-background-dark/50">
  <div class="mx-auto max-w-7xl px-6">
    <div class="text-center mb-16">
      <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-primary">Core Pillars</h2>
      <h3 class="mt-2 text-4xl font-bold text-teal-deep dark:text-white">Our Transformation Programs</h3>
    </div>
    <div class="grid gap-8 md:grid-cols-3 lg:grid-cols-5">
      {programs.map((program) => (
        <div class="group flex flex-col items-center p-8 text-center bg-sea-foam dark:bg-teal-deep/10 rounded-2xl transition-all hover:shadow-xl hover:-translate-y-2">
          <div class="mb-6 rounded-full bg-white dark:bg-background-dark p-4 text-primary shadow-sm group-hover:bg-primary group-hover:text-white transition-colors">
            <span class="material-symbols-outlined text-4xl">{program.icon}</span>
          </div>
          <h4 class="mb-3 font-bold text-teal-deep dark:text-white">{program.title}</h4>
          <p class="text-sm text-teal-deep/60 dark:text-slate-400">{program.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
