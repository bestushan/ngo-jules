---
<section id="team" class="py-24 bg-background-light dark:bg-background-dark">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
      <div class="max-w-xl">
        <h2 class="text-sm font-bold uppercase tracking-[0.2em] text-primary">Our Guardians</h2>
        <h3 class="mt-2 text-4xl font-bold text-teal-deep dark:text-white">Board of Directors</h3>
        <p class="mt-4 text-teal-deep/60 dark:text-slate-400">Our leadership resides and operates locally in Kandy, ensuring every initiative is culturally resonant and directly impactful.</p>
      </div>
      <a class="px-6 py-2 border-2 border-teal-deep/20 rounded-full font-bold text-teal-deep dark:text-slate-300 hover:bg-teal-deep hover:text-white transition-all" href="#">View All Members</a>
    </div>
    <div class="grid md:grid-cols-4 gap-8">
      {team.map((member) => (
        <div class="text-center group">
          <div class="mb-4 aspect-square overflow-hidden rounded-2xl grayscale group-hover:grayscale-0 transition-all duration-500">
            <img alt={member.name} class="h-full w-full object-cover" src={member.img} />
          </div>
          <h4 class="font-bold text-teal-deep dark:text-white">{member.name}</h4>
          <p class="text-sm text-primary font-medium">{member.role}</p>
        </div>
      ))}
    </div>
  </div>
</section>
