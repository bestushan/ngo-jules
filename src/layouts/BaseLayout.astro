---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "AFT Kids & Elders - Empowering vulnerable generations in Sri Lanka." } = Astro.props;
---

<!doctype html>
<html lang="en" class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 selection:bg-primary/30">
		<slot />
		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			// Entrance animations for sections
			const sections = document.querySelectorAll('section');
			sections.forEach((section) => {
				gsap.from(section, {
					opacity: 0,
					y: 50,
					duration: 1,
					ease: 'power3.out',
					scrollTrigger: {
						trigger: section,
						start: 'top 80%',
						toggleActions: 'play none none none',
					},
				}); section.classList.add('gsap-initialized');
			});

			// Hero text animation
			gsap.from('h1', {
				opacity: 0,
				y: 30,
				duration: 1.2,
				delay: 0.2,
				ease: 'power4.out',
			});

			const p = document.querySelector('h1 + p');
			if (p) {
				gsap.from(p, {
					opacity: 0,
					y: 20,
					duration: 1,
					delay: 0.5,
					ease: 'power3.out',
				});
			}
		</script>
		<style is:global>
			.golden-thread {
				position: relative;
			}
			.golden-thread::after {
				content: '';
				position: absolute;
				left: 50%;
				width: 2px;
				height: 100px;
				background: linear-gradient(to bottom, #ec5b13, transparent);
				z-index: 10;
			}
			.golden-thread-divider {
				background: linear-gradient(90deg, transparent 0%, #B8860B 50%, transparent 100%);
				height: 1px;
				width: 100%;
				opacity: 0.3;
			}
			.hero-gradient {
				background: linear-gradient(rgba(0, 77, 77, 0.4), rgba(26, 22, 20, 0.8));
			}
		</style>
	</body>
</html>
