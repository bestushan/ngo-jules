---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ImpactHero from '../components/ImpactHero.astro';
import ImpactDashboard from '../components/ImpactDashboard.astro';
import SuccessStories from '../components/SuccessStories.astro';
import LatestNews from '../components/LatestNews.astro';
import AnnualReports from '../components/AnnualReports.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Impact & News | AFT Kids & Elders">
  <Header variant="impact" />
  <main>
    <ImpactHero />
    <ImpactDashboard />
    <SuccessStories />
    <LatestNews />
    <AnnualReports />
  </main>
  <Footer variant="impact" />
</BaseLayout>
