---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import MissionHero from '../components/MissionHero.astro';
import OurStory from '../components/OurStory.astro';
import Programs from '../components/Programs.astro';
import Transparency from '../components/Transparency.astro';
import Team from '../components/Team.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Our Mission | AFT Kids & Elders">
	<Header variant="mission" />
	<main>
		<MissionHero />
		<OurStory />
		<Programs />
		<Transparency />
		<Team />
		<FinalCTA />
	</main>
	<Footer variant="mission" />
</BaseLayout>
