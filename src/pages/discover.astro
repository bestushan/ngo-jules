---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Discover Sri Lanka | AFT Kids & Elders">
	<Header variant="mission" />
	<main>
		<!-- Hero Section -->
		<section class="relative h-[60vh] flex items-center justify-center overflow-hidden">
			<div class="absolute inset-0 bg-cover bg-center" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuD6-Yw8bGjKQp-52k_tXswVhuBAjF1VkA_1bm1YTXartrds3AW_IZrInAoJ-YBawHxtdAqqtKSs3PrTM_S8a_s8W4DWoxRMvt17hTXHHi8badS1NO26Amxli6mXzbCs0kiFYWWcQEW2hiTIwgHWpEXnO_yXdicW7JMqHrruLR7e6-FSdDeLIUymsR6cnxrizoeRklMGBbE_OAz3L2A0s-NSApyn-3uIkUnx7v3WgEFaZC-RN_C4TOwvE3tujw8xyMowdkgHYJ83b95k')"></div>
			<div class="absolute inset-0 hero-gradient"></div>
			<div class="relative z-10 text-center px-6 max-w-4xl">
				<span class="inline-block text-primary font-bold tracking-[0.3em] uppercase text-xs mb-4">The Pearl of the Indian Ocean</span>
				<h1 class="text-white text-5xl md:text-7xl font-black leading-tight mb-6 tracking-tight">
					Discover <span class="text-primary italic font-serif">Sri Lanka</span>
				</h1>
				<p class="text-slate-200 text-lg md:text-xl font-light leading-relaxed max-w-2xl mx-auto">
					Explore the breathtaking landscapes and vibrant culture of the island we call home, from the misty hills of Kandy to the golden shores of the south.
				</p>
			</div>
		</section>

		<!-- Golden Thread Separator -->
		<div class="golden-thread-divider"></div>

		<!-- Cultural Heart Section -->
		<section class="py-24 bg-white dark:bg-background-dark">
			<div class="mx-auto max-w-7xl px-6">
				<div class="grid md:grid-cols-2 gap-16 items-center">
					<div class="relative">
						<div class="aspect-square overflow-hidden rounded-3xl shadow-2xl">
							<img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBIns19XM1sUHd4YJO0-6HauNLiEXgXpVedpk_3suHG-gXdCj4UmUHRKVszTSeLIa9_5AKm3vPqCLZy2LpRk5VTL_QzIwEoj4b_wi2O2TKv2Yvhjo5tIOkPHtF1XoEMerCNScZbVQGr-ZowVnqu2Pc1V7V4_6RdbL2yY-mbRaDqu6x60dWmiGqZ0ei8NcxH-t6Dqp3xehYAbnDpUC1hs3XT9b609u3F3ch4e7S3QoykDbGtEnabI2AeASe41elcZAumB5wZShv3AkIV" alt="Kandy Temple Details" class="h-full w-full object-cover">
						</div>
						<div class="absolute -bottom-8 -right-8 h-48 w-48 rounded-full border-8 border-white dark:border-background-dark bg-primary flex items-center justify-center shadow-2xl">
							<span class="material-symbols-outlined text-white text-6xl">temple_buddhist</span>
						</div>
					</div>
					<div class="space-y-8">
						<h2 class="text-4xl font-bold text-teal-deep dark:text-primary">Kandy: The Cultural Heart</h2>
						<p class="text-lg leading-relaxed text-teal-deep/80 dark:text-slate-300">
							Nestled amidst lush hills, Kandy is the last royal capital of Sri Lanka and a UNESCO World Heritage site. It's home to the Sacred Tooth Relic of the Buddha, making it a place of profound spiritual significance.
						</p>
						<p class="text-lg leading-relaxed text-teal-deep/80 dark:text-slate-300">
							The city's unique architecture, vibrant festivals, and temperate climate create a mystical atmosphere that has inspired poets and travelers for centuries.
						</p>
						<div class="grid grid-cols-2 gap-4">
							<div class="bg-sea-foam dark:bg-teal-deep/10 p-4 rounded-xl">
								<h4 class="font-bold text-primary">Sacred History</h4>
								<p class="text-sm text-teal-deep/60 dark:text-slate-400">Centuries of royal heritage.</p>
							</div>
							<div class="bg-sea-foam dark:bg-teal-deep/10 p-4 rounded-xl">
								<h4 class="font-bold text-primary">Hill Country</h4>
								<p class="text-sm text-teal-deep/60 dark:text-slate-400">Mist-covered mountains.</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Landscapes Grid -->
		<section class="py-24 bg-sea-foam dark:bg-background-dark/50">
			<div class="mx-auto max-w-7xl px-6">
				<div class="text-center mb-16">
					<h2 class="text-sm font-bold uppercase tracking-[0.2em] text-primary">Natural Wonders</h2>
					<h3 class="mt-2 text-4xl font-bold text-teal-deep dark:text-white">A Land of Infinite Variety</h3>
				</div>
				<div class="grid md:grid-cols-3 gap-8">
					<div class="group relative overflow-hidden rounded-2xl h-96">
						<img src="https://lh3.googleusercontent.com/aida-public/AB6AXuATQx5fKXvzyYaQYNBZCdi_sPa0M6KAwgNxdn6n3JlGO_FcfMpzxgDA4X8M4fZYL4MRphIcFLu92nBiQ0giqxXyXvg1hzJszoOF6hl-miSFnjMlthdG2xOy4boGwQIga7VvPI54_npoCjvqAqN0eadyglJUiPFE1pnrktJzIZMcVmX93_QNP5YvxCm98uIDzAQd2t1N8KWiohrpDFZttcVRD_can7Q00UfmrWOgfL3FQxK3kI5XGYibTbkADi9RNBvs4jY_dw0X_cuy" alt="Lush Greenery" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110">
						<div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
						<div class="absolute bottom-0 left-0 p-8 text-white">
							<h4 class="text-2xl font-bold mb-2">Central Highlands</h4>
							<p class="text-sm text-white/70">Rolling tea estates and cascading waterfalls.</p>
						</div>
					</div>
					<div class="group relative overflow-hidden rounded-2xl h-96">
						<img src="https://lh3.googleusercontent.com/aida-public/AB6AXuA7Z2ZD-IpJhv1WbdKwn-H9aiWMMXOD8zRXjXwhpOet5J623PTqTJd5XMmHYrevgRNLFLFbAuVuPD23dmy_6BqM6vkMZnZs9CwN0Vy6eqf9OKuMTZbevKY8sHVWO5dGL6JWy-sg19vzZk_mv3evwLwL0fpNbC9L03J8AqEFcdAJwSsTjtS2nt3PmjtZzZ0fKUhWNTKQeTR5_HdB0Rw1xx7zHFiz_tVj-C7wBjFkMZZrvwRF-CmWlWJE4TZJ4dOan5IBZpw5G6m0AIme" alt="Rural Village" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110">
						<div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
						<div class="absolute bottom-0 left-0 p-8 text-white">
							<h4 class="text-2xl font-bold mb-2">Vibrant Communities</h4>
							<p class="text-sm text-white/70">Warm smiles and ancient traditions in every village.</p>
						</div>
					</div>
					<div class="group relative overflow-hidden rounded-2xl h-96">
						<img src="https://lh3.googleusercontent.com/aida-public/AB6AXuA1Gv_F2it989A5Jmts3xNOdEOZe4RAUjAtaf2VWJqAn6laRTdCrMM87Sk5s6yohPCrfPMzW1nzEsIsOWzSnbjkemm0mLtbbu8VdcbKkTA1dy64-M5c_q0g39FAaFJqGuwIIv8OvDLwrStjK224zclhcyLI7-bf9k1AU4xyHmLBvSaxwKDafLYnJQMbSyceCh3-n1Z5gbyG1B53oME2up3fH5TVopQ75tijsv4L123qFaYZy0UMHhaFEZWvvYML98wHsXa2hdMK7VHI" alt="Coastal Life" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110">
						<div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
						<div class="absolute bottom-0 left-0 p-8 text-white">
							<h4 class="text-2xl font-bold mb-2">Tropical Coastline</h4>
							<p class="text-sm text-white/70">Turquoise waters and pristine golden sands.</p>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer variant="mission" />
</BaseLayout>
